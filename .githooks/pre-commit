#!/bin/sh
# Gate test: the full xUnit + bUnit suite runs in well under a second on this repo,
# so it gates every commit rather than being reserved for CI (CLAUDE.md: "Gate tests —
# deterministic, local, free, <2s. Run on every commit via pre-commit hook.").
set -e
cd "$(git rev-parse --show-toplevel)"
echo "Running gate tests (dotnet test JadwalSholat.sln)..."
dotnet test JadwalSholat.sln --nologo -v quiet
