@inherits LayoutComponentBase
@inject NavigationManager Nav
@implements IDisposable

<MudThemeProvider Theme="AppTheme.Theme" @bind-IsDarkMode="_isDarkMode" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudMainContent Class="@(IsSettingsPage ? "" : "app-main-content")">
    @Body

    @if (!IsSettingsPage)
    {
        <MudIconButton Icon="@Icons.Material.Filled.Settings"
                       Color="Color.Inherit"
                       Class="settings-fab"
                       Href="/settings"
                       aria-label="Pengaturan" />
    }
</MudMainContent>

@code {
    private bool _isDarkMode = true;

    private bool IsSettingsPage => Nav.Uri.Contains("/settings", StringComparison.OrdinalIgnoreCase);

    protected override void OnInitialized()
    {
        Nav.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
        => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        Nav.LocationChanged -= OnLocationChanged;
    }
}
