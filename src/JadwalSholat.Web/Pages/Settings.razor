@page "/settings"
@inject AppStateService AppState
@inject GeolocationService Geolocation
@inject PrayerTimeRepository Repository
@inject ISnackbar Snackbar

<PageTitle>Pengaturan - Jadwal Sholat</PageTitle>

<div class="settings-page">
    <div class="settings-topbar d-flex align-center" style="gap: 12px;">
        <MudIconButton Icon="@Icons.Material.Filled.ArrowBack" Href="." aria-label="Kembali" />
        <MudText Typo="Typo.h4">Pengaturan</MudText>
    </div>

    @if (_draft is null)
    {
        <div class="settings-loading">
            <MudProgressCircular Indeterminate="true" />
        </div>
    }
    else
    {
        <div class="settings-shell">
            <MudPaper Class="settings-sidebar" Elevation="0">
                <MudNavMenu Class="settings-nav">
                    @foreach (var item in _sections)
                    {
                        <MudNavLink Icon="@item.Icon"
                                    Class="@(item.Id == _active ? "settings-nav-link active" : "settings-nav-link")"
                                    OnClick="() => SelectSectionAsync(item.Id)">
                            @item.Label
                        </MudNavLink>
                    }
                    <MudDivider Class="my-2" />
                    <MudNavLink Icon="@Icons.Material.Filled.RestartAlt"
                                Class="@(_active == Section.Reset ? "settings-nav-link danger active" : "settings-nav-link danger")"
                                OnClick="() => _active = Section.Reset">
                        Reset
                    </MudNavLink>
                </MudNavMenu>
            </MudPaper>

            <MudPaper Class="settings-content" Elevation="0">
                @switch (_active)
                {
                    case Section.Lokasi:
                        <MudText Typo="Typo.h6" Class="mb-4">Lokasi</MudText>
                        <MudStack Spacing="4">
                            <MudRadioGroup T="LocationMode" Value="_draft.LocationMode" ValueChanged="v => _draft.LocationMode = v">
                                <MudRadio Value="LocationMode.Manual" Color="Color.Primary">Pilih kota manual</MudRadio>
                                <MudRadio Value="LocationMode.AutoDetect" Color="Color.Primary">Deteksi otomatis (GPS browser)</MudRadio>
                            </MudRadioGroup>

                            @if (_draft.LocationMode == LocationMode.Manual)
                            {
                                <MudAutocomplete T="City" Label="Kota" Variant="Variant.Outlined"
                                                 Value="City.FindById(_draft.CityId)"
                                                 ValueChanged="c => _draft.CityId = c?.Id ?? _draft.CityId"
                                                 SearchFunc="SearchCities"
                                                 ToStringFunc="CityDisplay"
                                                 ResetValueOnEmptyText="false" CoerceText="true" />
                            }
                            else
                            {
                                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="DetectLocationAsync" Disabled="_detecting">
                                    @(_detecting ? "Mendeteksi..." : "Deteksi Lokasi Sekarang")
                                </MudButton>
                                <MudText Typo="Typo.body2">
                                    Kota terpilih saat ini: <b>@(City.FindById(_draft.CityId)?.Name ?? "-")</b>
                                </MudText>
                                <MudAlert Severity="Severity.Info" Dense="true">
                                    Deteksi otomatis mencocokkan lokasi GPS Anda dengan kota terdekat dari
                                    @City.Bundled.Count kota yang didukung (seluruh ibukota provinsi dan beberapa
                                    kota besar lainnya).
                                </MudAlert>
                            }
                        </MudStack>
                        break;

                    case Section.Masjid:
                        <MudText Typo="Typo.h6" Class="mb-4">Masjid</MudText>
                        <MudStack Spacing="4">
                            <MudTextField @bind-Value="_draft.Mosque.Name" Label="Nama Masjid" Variant="Variant.Outlined" />
                            <MudTextField @bind-Value="_draft.Mosque.Address" Label="Alamat Masjid" Variant="Variant.Outlined" Lines="2" />
                        </MudStack>
                        break;

                    case Section.PenyesuaianWaktu:
                        <MudText Typo="Typo.h6" Class="mb-1">Penyesuaian Waktu</MudText>
                        <MudText Typo="Typo.body2" Class="mb-1">@IndonesianCalendar.FormatGregorianLong(_today)</MudText>
                        <MudText Typo="Typo.body2" Class="mb-4">
                            Menambah atau mengurangi jadwal waktu sholat dari API, dalam menit. Boleh negatif.
                            Angka di sebelah kiri tiap kolom adalah jadwal asli hari ini sebelum penyesuaian.
                        </MudText>
                        <MudStack Spacing="3">
                            @foreach (var name in PrayerNames.Chronological)
                            {
                                <MudStack Row="true" Spacing="3" AlignItems="AlignItems.Center">
                                    <MudText Typo="Typo.body1" Class="prayer-raw-time">
                                        @(_rawToday is not null ? _rawToday.Get(name).ToString("HH:mm") : "--:--")
                                    </MudText>
                                    <MudNumericField T="int" Label="@name.ToIndonesian()" Variant="Variant.Outlined"
                                                     Value="_draft.TimeAdjustmentMinutes[name]"
                                                     ValueChanged="v => _draft.TimeAdjustmentMinutes[name] = v"
                                                     Min="-60" Max="60" Adornment="Adornment.End" AdornmentText="menit"
                                                     Class="flex-grow-1" />
                                </MudStack>
                            }
                        </MudStack>
                        break;

                    case Section.Iqamah:
                        <MudText Typo="Typo.h6" Class="mb-1">Iqamah</MudText>
                        <MudText Typo="Typo.body2" Class="mb-4">Jeda dari Azan ke Iqamah, dalam menit. Default 10 menit.</MudText>
                        <MudStack Spacing="3">
                            @foreach (var name in PrayerNames.Obligatory)
                            {
                                <MudNumericField T="int" Label="@name.ToIndonesian()" Variant="Variant.Outlined"
                                                 Value="_draft.IqamahMinutes[name]"
                                                 ValueChanged="v => _draft.IqamahMinutes[name] = v"
                                                 Min="0" Max="60" Adornment="Adornment.End" AdornmentText="menit" />
                            }
                        </MudStack>
                        break;

                    case Section.DurasiSholat:
                        <MudText Typo="Typo.h6" Class="mb-1">Durasi Sholat</MudText>
                        <MudText Typo="Typo.body2" Class="mb-4">
                            Lama tampilan "Waktu Sholat" aktif, dihitung dari waktu Iqamah. Default 15 menit.
                        </MudText>
                        <MudStack Spacing="3">
                            @foreach (var name in PrayerNames.Obligatory)
                            {
                                <MudNumericField T="int" Label="@name.ToIndonesian()" Variant="Variant.Outlined"
                                                 Value="_draft.PrayerDurationMinutes[name]"
                                                 ValueChanged="v => _draft.PrayerDurationMinutes[name] = v"
                                                 Min="1" Max="120" Adornment="Adornment.End" AdornmentText="menit" />
                            }
                        </MudStack>
                        break;

                    case Section.Wallpaper:
                        <MudText Typo="Typo.h6" Class="mb-4">Wallpaper</MudText>
                        <MudStack Spacing="4">
                            <MudSwitch T="bool" Value="_draft.Wallpaper.Enabled" ValueChanged="v => _draft.Wallpaper.Enabled = v"
                                       Color="Color.Primary" Label="Aktifkan mode wallpaper" />
                            <MudNumericField T="int" Label="Interval pergantian wallpaper" Variant="Variant.Outlined"
                                             Value="_draft.Wallpaper.IntervalSeconds"
                                             ValueChanged="v => _draft.Wallpaper.IntervalSeconds = v"
                                             Min="3" Max="120" Adornment="Adornment.End" AdornmentText="detik" />

                            <MudText Typo="Typo.subtitle1">Daftar Wallpaper</MudText>
                            <MudStack Spacing="2">
                                @foreach (var item in _draft.Wallpaper.Items)
                                {
                                    <div class="wallpaper-list-row">
                                        <img src="@item.Url" alt="@item.Label" class="wallpaper-thumb" />
                                        <MudText Typo="Typo.body2" Class="flex-grow-1">@(item.Label ?? item.Url)</MudText>
                                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error"
                                                       OnClick="() => RemoveWallpaper(item)" aria-label="Hapus" />
                                    </div>
                                }
                                @if (_draft.Wallpaper.Items.Count == 0)
                                {
                                    <MudAlert Severity="Severity.Warning" Dense="true">
                                        Belum ada wallpaper. Tambahkan URL gambar di bawah.
                                    </MudAlert>
                                }
                            </MudStack>

                            <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Start">
                                <MudTextField T="string" @bind-Value="_newWallpaperUrl" Label="URL Gambar Wallpaper"
                                              Variant="Variant.Outlined" Class="flex-grow-1"
                                              HelperText="Tempelkan alamat (URL) gambar yang bisa diakses publik, contoh: https://.../gambar.jpg" />
                                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="AddWallpaper"
                                           Disabled="string.IsNullOrWhiteSpace(_newWallpaperUrl)">
                                    Tambah
                                </MudButton>
                            </MudStack>
                        </MudStack>
                        break;

                    case Section.Tentang:
                        <MudText Typo="Typo.h6" Class="mb-4">Tentang</MudText>
                        <MudStack Spacing="4">
                            <MudText Typo="Typo.body1">
                                Jadwal Sholat adalah aplikasi jadwal sholat yang berjalan sepenuhnya di browser
                                (client-side), tanpa server backend. Semua pengaturan di halaman ini — lokasi,
                                masjid, penyesuaian waktu, iqamah, durasi sholat, dan wallpaper — disimpan langsung
                                di <code>localStorage</code> browser Anda, bukan di server manapun.
                            </MudText>

                            <MudStack Spacing="1">
                                <MudText Typo="Typo.subtitle1">Kebijakan Privasi</MudText>
                                <MudText Typo="Typo.body1">
                                    Aplikasi ini tidak mengumpulkan data pribadi apa pun dari pengunjung:
                                </MudText>
                                <ul style="margin:0; padding-left:1.25rem;">
                                    <li>
                                        <MudText Typo="Typo.body1">
                                            Tidak ada akun, cookie pelacak, atau analytics/iklan pihak ketiga.
                                        </MudText>
                                    </li>
                                    <li>
                                        <MudText Typo="Typo.body1">
                                            Semua pengaturan (lokasi, masjid, wallpaper, dsb.) hanya tersimpan di
                                            <code>localStorage</code> browser Anda sendiri — tidak pernah dikirim
                                            atau disimpan di server manapun.
                                        </MudText>
                                    </li>
                                    <li>
                                        <MudText Typo="Typo.body1">
                                            Jika deteksi lokasi otomatis diaktifkan, koordinat GPS diproses
                                            sepenuhnya di browser Anda untuk mencocokkan kota terdekat, dan tidak
                                            pernah dikirim ke mana pun.
                                        </MudText>
                                    </li>
                                    <li>
                                        <MudText Typo="Typo.body1">
                                            Semua data ini bisa Anda hapus kapan saja lewat menu "Reset" di halaman
                                            ini, atau dengan membersihkan data situs di browser Anda.
                                        </MudText>
                                    </li>
                                </ul>
                            </MudStack>

                            <MudStack Spacing="1">
                                <MudText Typo="Typo.subtitle1">Source Code</MudText>
                                <MudLink Href="https://github.com/novrianfh/JadwalSholat" Target="_blank">
                                    github.com/novrianfh/JadwalSholat
                                </MudLink>
                            </MudStack>

                            <MudStack Spacing="1">
                                <MudText Typo="Typo.subtitle1">Saran &amp; Diskusi</MudText>
                                <MudLink Href="https://instagram.com/nvrnfjr" Target="_blank">Instagram @@nvrnfjr</MudLink>
                                <MudLink Href="mailto:novrian.fh@live.com">novrian.fh@live.com</MudLink>
                            </MudStack>
                        </MudStack>
                        break;

                    case Section.Reset:
                        <MudText Typo="Typo.h6" Class="mb-4">Reset Pengaturan</MudText>
                        <MudAlert Severity="Severity.Warning" Class="mb-4">
                            Tindakan ini akan mengembalikan semua pengaturan (lokasi, masjid, penyesuaian waktu,
                            iqamah, durasi sholat, dan wallpaper) ke nilai bawaan. Perubahan baru berlaku setelah
                            Anda menekan "Simpan Pengaturan".
                        </MudAlert>

                        @if (!_confirmingReset)
                        {
                            <MudButton Variant="Variant.Outlined" Color="Color.Error"
                                       StartIcon="@Icons.Material.Filled.RestartAlt"
                                       OnClick="() => _confirmingReset = true">
                                Reset ke Default
                            </MudButton>
                        }
                        else
                        {
                            <MudStack Spacing="3">
                                <MudText Typo="Typo.body1">Yakin ingin mereset semua pengaturan ke default?</MudText>
                                <MudStack Row="true" Spacing="2">
                                    <MudButton Variant="Variant.Filled" Color="Color.Error" OnClick="ResetToDefault">
                                        Ya, Reset Sekarang
                                    </MudButton>
                                    <MudButton Variant="Variant.Text" Color="Color.Default" OnClick="() => _confirmingReset = false">
                                        Batal
                                    </MudButton>
                                </MudStack>
                            </MudStack>
                        }
                        break;
                }

                @if (_active != Section.Tentang)
                {
                    <MudStack Row="true" Spacing="3" Class="mt-8" Justify="Justify.FlexEnd">
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveAsync">Simpan Pengaturan</MudButton>
                    </MudStack>
                }
            </MudPaper>
        </div>
    }
</div>

@code {
    private enum Section
    {
        Lokasi,
        Masjid,
        PenyesuaianWaktu,
        Iqamah,
        DurasiSholat,
        Wallpaper,
        Tentang,
        Reset,
    }

    private sealed record SectionInfo(Section Id, string Label, string Icon);

    private readonly SectionInfo[] _sections =
    [
        new(Section.Lokasi, "Lokasi", Icons.Material.Filled.LocationOn),
        new(Section.Masjid, "Masjid", Icons.Material.Filled.Mosque),
        new(Section.PenyesuaianWaktu, "Penyesuaian Waktu", Icons.Material.Filled.Schedule),
        new(Section.Iqamah, "Iqamah", Icons.Material.Filled.NotificationsActive),
        new(Section.DurasiSholat, "Durasi Sholat", Icons.Material.Filled.Timer),
        new(Section.Wallpaper, "Wallpaper", Icons.Material.Filled.Image),
        new(Section.Tentang, "Tentang", Icons.Material.Filled.Info),
    ];

    private Section _active = Section.Lokasi;
    private bool _confirmingReset;
    private AppSettings? _draft;
    private bool _detecting;
    private string _newWallpaperUrl = "";
    private readonly DateOnly _today = DateOnly.FromDateTime(DateTime.Now);
    private DailyPrayerTimes? _rawToday;

    protected override async Task OnInitializedAsync()
    {
        await AppState.EnsureLoadedAsync();
        _draft = CloneSettings(AppState.Settings);
    }

    private async Task SelectSectionAsync(Section id)
    {
        _active = id;
        if (id == Section.PenyesuaianWaktu)
        {
            await LoadRawTodayAsync();
        }
    }

    /// <summary>Raw (pre-adjustment) prayer times for the currently selected city, shown next to each
    /// adjustment input so the user can see what they're adjusting from.</summary>
    private async Task LoadRawTodayAsync()
    {
        var city = await Repository.GetCityScheduleAsync(_draft!.CityId);
        _rawToday = city is not null && city.DaysByDate.TryGetValue(_today, out var raw) ? raw : null;
    }

    private static string CityDisplay(City? city) => city is null ? string.Empty : $"{city.Name} ({city.Region})";

    private static Task<IEnumerable<City>> SearchCities(string value, CancellationToken token)
    {
        IEnumerable<City> results = string.IsNullOrWhiteSpace(value)
            ? City.Bundled
            : City.Bundled.Where(c =>
                c.Name.Contains(value, StringComparison.OrdinalIgnoreCase) ||
                c.Region.Contains(value, StringComparison.OrdinalIgnoreCase));
        return Task.FromResult(results);
    }

    private static AppSettings CloneSettings(AppSettings source)
    {
        var json = System.Text.Json.JsonSerializer.Serialize(source);
        return System.Text.Json.JsonSerializer.Deserialize<AppSettings>(json) ?? AppSettings.CreateDefault();
    }

    private async Task DetectLocationAsync()
    {
        _detecting = true;
        try
        {
            var position = await Geolocation.TryGetCurrentPositionAsync();
            if (position is null)
            {
                Snackbar.Add("Tidak dapat mendeteksi lokasi. Periksa izin lokasi browser.", Severity.Error);
                return;
            }

            var nearest = City.Nearest(position.Latitude, position.Longitude);
            _draft!.CityId = nearest.Id;
            Snackbar.Add($"Lokasi terdeteksi: {nearest.Name}", Severity.Success);
        }
        finally
        {
            _detecting = false;
        }
    }

    private void AddWallpaper()
    {
        if (string.IsNullOrWhiteSpace(_newWallpaperUrl)) return;
        _draft!.Wallpaper.Items.Add(new WallpaperItem { Url = _newWallpaperUrl.Trim() });
        _newWallpaperUrl = "";
    }

    private void RemoveWallpaper(WallpaperItem item) => _draft!.Wallpaper.Items.Remove(item);

    private void ResetToDefault()
    {
        _draft = AppSettings.CreateDefault();
        _draft.Wallpaper.Items = DefaultWallpapers.CreateSeedSet();
        _confirmingReset = false;
        Snackbar.Add("Pengaturan dikembalikan ke default. Tekan \"Simpan Pengaturan\" untuk menyimpan.", Severity.Info);
    }

    private async Task SaveAsync()
    {
        await AppState.SaveAsync(_draft!);
        Snackbar.Add("Pengaturan disimpan.", Severity.Success);
    }
}
